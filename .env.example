# Copia este archivo a .env para desarrollo local. Nunca versiones .env ni secretos reales.
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (docker compose local)
DATABASE_URL=postgres://volt:volt@localhost:5432/volt

# Redis (docker compose local)
REDIS_URL=redis://localhost:6379

# Gateway OCPP
OCPP_GATEWAY_PORT=9220
OCPP_GATEWAY_HEALTH_PORT=9221
# Rutas aceptadas: /ocpp/{chargeBoxId}
OCPP_GATEWAY_PATH_PREFIX=/ocpp
# Registro estático de cargadores solo cuando NO hay DATABASE_URL (laboratorio sin base de datos).
# OCPP_STATIC_REGISTRY=[{"identity":"CP001","password":"cambia-esta-clave","lifecycle":"OPERATIONAL"}]
# API interna de comandos (api/worker -> gateway, ADR 0013). Cambia el token: mínimo 16 caracteres.
OCPP_GATEWAY_INTERNAL_PORT=9222
OCPP_GATEWAY_INTERNAL_TOKEN=cambia-este-token-interno-local
# URL del gateway para api/worker cuando no hay REDIS_URL (un solo gateway local)
OCPP_GATEWAY_INTERNAL_URL=http://127.0.0.1:9222
# Identificador del pod en el directorio de conexiones (por defecto el hostname)
# OCPP_GATEWAY_POD_ID=gw-local

# API
API_PORT=8080
# Token estático de la API de administración /admin/v1 (solo laboratorio y pruebas; prohibido en producción)
API_ADMIN_TOKEN=cambia-este-token-admin-local
# Iteración 6: personal con Identity Platform (obligatorio en producción). La clave web es pública.
# IDENTITY_PLATFORM_PROJECT_ID=volt-dev-xxxx
# IDENTITY_PLATFORM_API_KEY=AIza...
# IDENTITY_PLATFORM_AUTH_DOMAIN=volt-dev-xxxx.firebaseapp.com
# Primer administrador (se invita al arrancar si no hay personal registrado)
# API_STAFF_BOOTSTRAP_EMAIL=dueno@supercargadores.co
# Orígenes del back-office y de la app web autorizados por CORS (en desarrollo Vite reenvía /admin/v1 y no hace falta)
# API_CORS_ORIGINS=https://admin.supercargadores.co,https://app.supercargadores.co
# Iteración 7: tenant de Identity Platform reservado a conductores (opcional; sin él comparten el pool del proyecto)
# IDENTITY_PLATFORM_DRIVER_TENANT_ID=conductores-xxxx
# Enlaces legales y soporte que muestra la app (GET /v1/config)
# APP_TERMS_URL=https://supercargadores.co/terminos-y-condiciones
# APP_PRIVACY_URL=https://supercargadores.co/politica-de-datos
# APP_SUPPORT_EMAIL=soporte@supercargadores.co
# Iteración 9: clave de navegador de Maps JavaScript API (pública, restringida por referrer) para el mapa de la
# app web; el back-office la toma de VITE_GOOGLE_MAPS_BROWSER_KEY (Vite) o de GOOGLE_MAPS_BROWSER_KEY (contenedor).
# GOOGLE_MAPS_BROWSER_KEY=AIza...
# VITE_GOOGLE_MAPS_BROWSER_KEY=AIza...
# Map ID (estilos en la nube y marcadores avanzados; público): la app lo toma de GET /v1/config y el back-office de
# VITE_GOOGLE_MAPS_MAP_ID (Vite) o GOOGLE_MAPS_MAP_ID (contenedor). Vacío = marcadores clásicos.
# GOOGLE_MAPS_MAP_ID=
# VITE_GOOGLE_MAPS_MAP_ID=
# Espera máxima a que un cargador reconecte tras un Reset durante el comisionamiento
COMMISSIONING_REBOOT_WAIT_MS=30000
# Identidad de conductor de desarrollo (Authorization: Bearer dev:<driverId>); solo local, nunca en producción
API_DEV_DRIVER_AUTH=true
# Flujo SSE de sesiones: sondeo del outbox y latido
API_SSE_POLL_MS=1000
API_SSE_HEARTBEAT_MS=15000

# Worker
# Hora UTC de la revisión diaria de deriva (09:00 UTC = 04:00 en Bogotá) y ritmo máximo
WORKER_DRIFT_CHECK_HOUR_UTC=9
# Hora UTC de la verificación diaria de la cadena de auditoría
WORKER_AUDIT_CHECK_HOUR_UTC=7
WORKER_DRIFT_RATE_PER_S=20
WORKER_DRIFT_ENABLED=true
# Relay del outbox (Redis local; Pub/Sub en la iteración 8), timeouts de arranque y huérfanas
WORKER_OUTBOX_POLL_MS=200
WORKER_OUTBOX_BATCH=500
WORKER_EVENTS_CHANNEL=domain-events
WORKER_SESSION_TIMEOUT_POLL_MS=10000
WORKER_ORPHAN_TIMEOUT_H=12
WORKER_ORPHAN_POLL_MS=60000
# Iteración 4: liquidación de sesiones, límites (tope de exposición, duración máxima) y activación de tarifas
WORKER_PRICING_POLL_MS=5000
WORKER_LIMITS_POLL_MS=3000
WORKER_TARIFF_POLL_MS=60000

# Iteración 5: pagos. PAYMENTS_PROVIDER=wompi con las llaves del sandbox (nunca en el repositorio;
# en producción vienen de Secret Manager), fake = emulador en memoria (desarrollo y pruebas), none = sin cobro.
PAYMENTS_PROVIDER=fake
WOMPI_ENVIRONMENT=sandbox
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_INTEGRITY_SECRET=test_integrity_...
# WOMPI_EVENTS_SECRET=test_events_...
# Página de la app a la que vuelve el checkout (Wompi o el emulado) con ?resultado=aprobado|rechazado&referencia=...
# PAYMENTS_REDIRECT_URL=https://app-dev.supercargadores.co/pagos/retorno
# URL pública de la API: con PAYMENTS_PROVIDER=fake los enlaces de pago apuntan al checkout emulado
# que sirve la propia API en /v1/pay/emulado/:linkId (en local se usa http://localhost:8080).
# API_PUBLIC_URL=https://api-dev.supercargadores.co
WORKER_BILLING_POLL_MS=10000
WORKER_RECONCILIATION_HOUR_UTC=8

# Iteración 7: notificaciones push al conductor desde el worker. expo = Expo Push (obligatorio en producción),
# log = solo registra (desarrollo), none = desactivado. El token de Expo es opcional.
PUSH_PROVIDER=log
# EXPO_ACCESS_TOKEN=
WORKER_PUSH_POLL_MS=2000
WORKER_PUSH_BATCH=100
WORKER_PUSH_LOOKBACK_H=24

# Celular verificado por SMS (ADR 0031): fake = emulador (el código vuelve en la respuesta y va al log;
# solo desarrollo y pruebas), twilio (TWILIO_ACCOUNT_SID, SMS_SENDER = número E.164 o Messaging Service,
# SMS_PROVIDER_API_KEY = auth token), brevo (SMS_SENDER = nombre de hasta 11 caracteres, SMS_PROVIDER_API_KEY
# = clave de API) o none. En producción es obligatorio twilio o brevo.
SMS_PROVIDER=fake
# SMS_SENDER=VOLT
# TWILIO_ACCOUNT_SID=AC...
# SMS_PROVIDER_API_KEY=

# Correos de identidad con la marca (ADR 0032): resend o brevo (EMAIL_PROVIDER_API_KEY = clave del proveedor,
# EMAIL_FROM con dominio verificado) hacen que la API envíe verificación y contraseña con el cuerpo propio;
# fake los guarda en memoria (pruebas); none deja el correo genérico de Identity Platform. Los enlaces salen
# de la cuenta de servicio de Cloud Run (IDENTITY_LINKS_SOURCE=metadata) o son falsos en local.
EMAIL_PROVIDER=none
# EMAIL_FROM=VOLT <notificaciones@supercargadores.co>
# EMAIL_PROVIDER_API_KEY=
# APP_WEB_URL=https://app-dev.supercargadores.co
# IDENTITY_LINKS_SOURCE=fake

# App Volt (apps/mobile): URL de la API en tiempo de compilación; en Expo Go sin esta variable se usa la
# máquina que sirve el bundle en el puerto 8080.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Iteración 8 (nube, ADR 0023). En local no hacen falta.
# VOLT_ENV separa el ambiente (dev, staging, prod) de NODE_ENV: las reglas "solo en producción" aplican con prod.
# VOLT_ENV=local
# CA del servidor de Cloud SQL (PEM) para TLS con verificación; en GKE llega como DATABASE_SSL_CA_FILE.
# DATABASE_SSL_CA=
# Salud del worker (Cloud Run exige un puerto abierto); 0 lo desactiva.
# WORKER_HEALTH_PORT=0
# Publicación de los eventos del outbox también en Pub/Sub (projects/<id>/topics/domain-events).
# OUTBOX_PUBSUB_TOPIC=
# Vigilancia de conexiones: sondeo, gracia antes de la alarma CHARGER_OFFLINE y umbral CRITICAL por sede.
# WORKER_CONNECTION_WATCH_POLL_MS=15000
# WORKER_OFFLINE_GRACE_S=30
# WORKER_OFFLINE_SITE_CRITICAL_RATIO=0.3
# Cargador sintético (apps/synthetic-charger): gateway al que se conecta y su identidad.
# SYNTHETIC_OCPP_URL=ws://localhost:9220/ocpp
# SYNTHETIC_CHARGE_BOX_ID=VOLT-SYNTH
# SYNTHETIC_PASSWORD=cambia-esta-clave
# Iteración 9: publica el cargador sintético en la app como estación de pruebas con la tarifa base (nunca en prod).
# SYNTHETIC_VISIBLE_IN_APP=true
