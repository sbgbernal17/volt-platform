{
  "name": "@volt/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Procesos en segundo plano: relay del outbox, timeouts, reconciliación, notificaciones",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.mjs"
  },
  "dependencies": {
    "@volt/csms": "workspace:*",
    "@volt/db": "workspace:*",
    "@volt/events": "workspace:*",
    "@volt/gateway-client": "workspace:*",
    "@volt/payments": "workspace:*",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
