{
  "name": "@volt/api",
  "version": "0.1.0",
  "private": true,
  "description": "API pública (/v1) y de back-office del CSMS",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.mjs"
  },
  "dependencies": {
    "@volt/csms": "workspace:*",
    "@volt/db": "workspace:*",
    "@volt/domain": "workspace:*",
    "@volt/gateway-client": "workspace:*",
    "@volt/payments": "workspace:*",
    "@volt/security": "workspace:*",
    "@volt/tariff-engine": "workspace:*",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@volt/ocpp-gateway": "workspace:*",
    "@volt/ocpp-sim": "workspace:*",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
