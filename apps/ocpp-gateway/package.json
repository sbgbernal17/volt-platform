{
  "name": "@volt/ocpp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway OCPP 1.6J: servidor WebSocket persistente para los cargadores",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.mjs"
  },
  "dependencies": {
    "@volt/domain": "workspace:*",
    "@volt/events": "workspace:*",
    "@volt/ocpp-schemas": "workspace:*",
    "ocpp-rpc": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
